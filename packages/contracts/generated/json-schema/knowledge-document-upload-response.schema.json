{
  "type": "object",
  "required": [
    "document",
    "chunks"
  ],
  "properties": {
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "workspace_id",
        "title",
        "source",
        "status",
        "chunk_count"
      ],
      "properties": {
        "document_id": {
          "minLength": 1,
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "const": "active",
              "type": "string"
            },
            {
              "const": "disabled",
              "type": "string"
            },
            {
              "const": "deleted",
              "type": "string"
            }
          ]
        },
        "chunk_count": {
          "minimum": 0,
          "type": "number"
        },
        "created_by": {
          "minLength": 1,
          "type": "string"
        },
        "created_at": {
          "description": "ISO 8601 timestamp",
          "type": "string"
        },
        "updated_at": {
          "description": "ISO 8601 timestamp",
          "type": "string"
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "chunk_index",
          "text",
          "permission_tags"
        ],
        "properties": {
          "chunk_id": {
            "minLength": 1,
            "type": "string"
          },
          "document_id": {
            "minLength": 1,
            "type": "string"
          },
          "chunk_index": {
            "minimum": 0,
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "permission_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
