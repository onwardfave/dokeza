DOKEZA_ENV=local
LOG_LEVEL=info
PORT=3000

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=dokeza
POSTGRES_PASSWORD=dokeza_local
POSTGRES_DB=dokeza
DATABASE_URL=postgresql://dokeza:dokeza_local@localhost:5432/dokeza

# Telemetry
DOKEZA_TELEMETRY_ENABLED=true
DOKEZA_TELEMETRY_CONTENT_LOGGING_ALLOWED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=1
