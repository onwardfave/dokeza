DOKEZA_ENV=local
LOG_LEVEL=info
PORT=3000

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=dokeza
POSTGRES_PASSWORD=dokeza_local
POSTGRES_DB=dokeza
DATABASE_URL=postgresql://dokeza:dokeza_local@localhost:5432/dokeza

# Telemetry
DOKEZA_TELEMETRY_ENABLED=true
DOKEZA_TELEMETRY_CONTENT_LOGGING_ALLOWED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=1

# Providers — STT (Deepgram)
# Set DEEPGRAM_API_KEY to use real Deepgram STT; unset falls back to a
# deterministic adapter in local/test.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Providers — LLM (live suggestions)
# DOKEZA_LLM_PROVIDER selects the path:
#   deterministic — offline fake (default outside production)
#   openai        — OpenAI Responses API (/v1/responses)
#   openai_chat   — any OpenAI-compatible Chat Completions API (/v1/chat/completions),
#                   e.g. NVIDIA build.nvidia.com, Together, local vLLM/Ollama
# OPENAI_BASE_URL + OPENAI_MODEL choose the endpoint and model in every environment,
# including production (base URL must be https in production).
# DOKEZA_LLM_PROVIDER=openai_chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.1-8b-instruct

# Providers — embeddings (knowledge retrieval)
# DOKEZA_EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Auth
DOKEZA_DEV_AUTH_ENABLED=true
DOKEZA_AUTH_ISSUER=https://auth.local.dokeza.dev
DOKEZA_AUTH_AUDIENCE=dokeza
DOKEZA_AUTH_SIGNING_SECRET=dev_only_dokeza_auth_secret_do_not_use
DOKEZA_HOSTED_AUTH_ENABLED=false
# DOKEZA_HOSTED_AUTH_ISSUER=https://idp.example.com/
# DOKEZA_HOSTED_AUTH_AUDIENCE=dokeza-api
# DOKEZA_HOSTED_AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# DOKEZA_HOSTED_AUTH_JWKS_CACHE_TTL_SECONDS=300
