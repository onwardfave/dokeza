{
  "name": "dokeza",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm check && pnpm --filter @dokeza/desktop build",
    "desktop:release:check": "node scripts/desktop-release/validate-release-config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schemas": "pnpm --filter @dokeza/contracts generate:schemas",
    "lint": "eslint . --max-warnings 0",
    "observability:config": "docker compose --env-file infra/observability/.env.example -f infra/observability/docker-compose.yml config",
    "observability:down": "docker compose --env-file infra/observability/.env.example -f infra/observability/docker-compose.yml down",
    "observability:up": "docker compose --env-file infra/observability/.env.example -f infra/observability/docker-compose.yml up -d",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:secrets": "gitleaks detect --source . --no-banner --redact",
    "security:vulns": "trivy fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 .",
    "test": "pnpm -r --if-present test",
    "toolchain:verify": "pwsh -NoLogo -NoProfile -File scripts/verify-toolchain.ps1",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
