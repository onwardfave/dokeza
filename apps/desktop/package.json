{
  "name": "@dokeza/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "security:config:local": "tsx scripts/write-tauri-security-config.ts local",
    "security:config:production": "tsx scripts/write-tauri-security-config.ts production",
    "tauri": "tauri",
    "tauri:dev:configured": "pnpm security:config:local && tauri dev --config src-tauri/tauri.security.generated.json",
    "tauri:build:configured": "pnpm security:config:production && tauri build --config src-tauri/tauri.security.generated.json",
    "test": "vitest run src",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@dokeza/contracts": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.23.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
