{
  "type": "object",
  "required": [
    "meeting",
    "transcript",
    "suggestions"
  ],
  "properties": {
    "meeting": {
      "type": "object",
      "required": [
        "meeting_id",
        "workspace_id",
        "created_by",
        "meeting_source",
        "status",
        "segment_count",
        "gap_count"
      ],
      "properties": {
        "meeting_id": {
          "minLength": 1,
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "type": "string"
        },
        "meeting_source": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "const": "active",
              "type": "string"
            },
            {
              "const": "paused",
              "type": "string"
            },
            {
              "const": "ended",
              "type": "string"
            }
          ]
        },
        "started_at": {
          "description": "ISO 8601 timestamp",
          "type": "string"
        },
        "ended_at": {
          "description": "ISO 8601 timestamp",
          "type": "string"
        },
        "segment_count": {
          "minimum": 0,
          "type": "number"
        },
        "gap_count": {
          "minimum": 0,
          "type": "number"
        }
      }
    },
    "transcript": {
      "type": "object",
      "required": [
        "segments",
        "gaps"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "segment_id",
              "speaker",
              "text",
              "start_ms",
              "end_ms",
              "confidence"
            ],
            "properties": {
              "segment_id": {
                "minLength": 1,
                "type": "string"
              },
              "speaker": {
                "anyOf": [
                  {
                    "const": "user",
                    "type": "string"
                  },
                  {
                    "const": "remote",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "text": {
                "type": "string"
              },
              "start_ms": {
                "minimum": 0,
                "type": "number"
              },
              "end_ms": {
                "minimum": 0,
                "type": "number"
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stream",
              "start_ms",
              "end_ms",
              "dropped_chunks",
              "reason"
            ],
            "properties": {
              "stream": {
                "anyOf": [
                  {
                    "const": "microphone",
                    "type": "string"
                  },
                  {
                    "const": "system",
                    "type": "string"
                  }
                ]
              },
              "start_ms": {
                "minimum": 0,
                "type": "number"
              },
              "end_ms": {
                "minimum": 0,
                "type": "number"
              },
              "dropped_chunks": {
                "minimum": 1,
                "type": "number"
              },
              "reason": {
                "anyOf": [
                  {
                    "const": "local_buffer_full",
                    "type": "string"
                  },
                  {
                    "const": "policy_buffer_disabled",
                    "type": "string"
                  },
                  {
                    "const": "user_paused_capture",
                    "type": "string"
                  },
                  {
                    "const": "device_unavailable",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suggestion_id",
          "kind",
          "content",
          "sources",
          "confidence",
          "prompt_version",
          "model"
        ],
        "properties": {
          "suggestion_id": {
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "answer_question",
                "type": "string"
              },
              {
                "const": "summarize_so_far",
                "type": "string"
              },
              {
                "const": "suggest_follow_up",
                "type": "string"
              },
              {
                "const": "objection_response",
                "type": "string"
              }
            ]
          },
          "content": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "title",
                "chunk_id"
              ],
              "properties": {
                "document_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "chunk_id": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "anyOf": [
              {
                "const": "low",
                "type": "string"
              },
              {
                "const": "medium",
                "type": "string"
              },
              {
                "const": "high",
                "type": "string"
              }
            ]
          },
          "prompt_version": {
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "server_seq": {
            "minimum": 0,
            "type": "number"
          },
          "created_at": {
            "description": "ISO 8601 timestamp",
            "type": "string"
          }
        }
      }
    }
  }
}
